# LiveKit Cloud credentials — create a free project at https://cloud.livekit.io
# Project Settings → Keys. The URL looks like wss://<project>.livekit.cloud
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Backend
PORT=3000

# Database — local Postgres from infra/docker/docker-compose.yml
# (`docker compose -f infra/docker/docker-compose.yml up -d`)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/virtual_workspace

# Position spike (scripts/livekit-position-spike.ts)
BACKEND_URL=http://localhost:3000
SPIKE_ROOM=spike-room
