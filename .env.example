# LiveKit Cloud credentials — create a free project at https://cloud.livekit.io
# Project Settings → Keys. The URL looks like wss://<project>.livekit.cloud
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Backend
PORT=3000

# Database — local Postgres from infra/docker/docker-compose.yml
# (`docker compose -f infra/docker/docker-compose.yml up -d`)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/virtual_workspace

# Auth — JWT signing. Use a long random string in real environments.
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=1h

# Google sign-in — the only login path in the UI.
# Google Cloud console → APIs & Services → Credentials → OAuth client ID (Web).
# Add http://localhost:5173 as an Authorized JavaScript origin.
# Both vars take the SAME client id: the backend verifies ID tokens against it,
# the frontend opens the sign-in popup with it. Only the id is public; there is
# no client secret in this flow.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Email — one-time login codes.
# Leave RESEND_API_KEY empty for local dev: the backend then logs codes to stdout
# instead of emailing them, so you can sign in with no provider account. Set it
# to send for real (https://resend.com → API Keys); the backend refuses to boot
# in production without it, so codes are never logged on a real deployment.
# MAIL_FROM must be an address on a domain you verified with Resend —
# onboarding@resend.dev works out of the box for testing.
RESEND_API_KEY=
MAIL_FROM="Vorkium <onboarding@resend.dev>"

# Position spike (scripts/livekit-position-spike.ts)
BACKEND_URL=http://localhost:3000
SPIKE_ROOM=spike-room

# Map-design MCP server (tools/map-mcp) — only needed when you run the map tools.
# The defaults work with no credentials: content/assets/ is the catalog.
#
# To layer remote catalogs on top, set ASSET_APIS to a JSON array. The local
# catalog is always included and always first, so a local record with the same id
# as a vendor record wins. Keys are passed to the container at run time and are
# never baked into the image or logged.
#   ASSET_APIS=[{"name":"vendorA","url":"https://a.example.com/v1","key":"..."}]
ASSET_APIS=

# Legacy single-source pair — used only when ASSET_APIS is unset.
ASSET_SOURCE=local
ASSET_API_URL=
ASSET_API_KEY=
MAP_MCP_LOG_LEVEL=warn
MAP_MCP_OFFLINE=false
