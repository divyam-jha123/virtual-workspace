# LiveKit Cloud credentials — create a free project at https://cloud.livekit.io
# Project Settings → Keys. The URL looks like wss://<project>.livekit.cloud
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Backend
PORT=3000

# Database — local Postgres from infra/docker/docker-compose.yml
# (`docker compose -f infra/docker/docker-compose.yml up -d`)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/virtual_workspace

# Auth — JWT signing. Use a long random string in real environments.
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=1h

# Google sign-in — the only login path in the UI.
# Google Cloud console → APIs & Services → Credentials → OAuth client ID (Web).
# Add http://localhost:5173 as an Authorized JavaScript origin.
# Both vars take the SAME client id: the backend verifies ID tokens against it,
# the frontend opens the sign-in popup with it. Only the id is public; there is
# no client secret in this flow.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Position spike (scripts/livekit-position-spike.ts)
BACKEND_URL=http://localhost:3000
SPIKE_ROOM=spike-room
