// First database in the project (Phase 1). The stateless-REST constraint still
// holds: no game-state lives here — position/presence/chat ride LiveKit. The DB
// only persists accounts (and, later, minimal presence metadata).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A persisted user account. Backs JWT auth (#24) and presence metadata (#26).
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  displayName  String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Minimal room membership / last-seen, written from LiveKit webhooks (#26).
/// This is presence *metadata* only — no position or game state lives here
/// (Option B: those ride LiveKit). One row per (room, participant identity);
/// `leftAt == null` means the participant is currently connected.
model RoomMembership {
  id          String    @id @default(cuid())
  roomName    String
  identity    String
  displayName String?
  joinedAt    DateTime  @default(now())
  leftAt      DateTime?
  lastSeenAt  DateTime  @default(now())

  @@unique([roomName, identity])
  @@index([roomName, leftAt])
}
