// First database in the project (Phase 1). The stateless-REST constraint still
// holds: no game-state lives here — position/presence/chat ride LiveKit. The DB
// only persists accounts (and, later, minimal presence metadata).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A persisted user account. Backs JWT auth (#24) and presence metadata (#26).
///
/// An account arrives one of two ways: the dev seed (email + passwordHash) or
/// Google sign-in (googleId, no password). Both are keyed on `email`, so the
/// same person signing in either way lands on one row.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  displayName  String
  /// Null for Google accounts — they authenticate via `googleId` instead.
  passwordHash String?
  /// Google's stable subject id. Null until the user signs in with Google.
  googleId     String?  @unique
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
