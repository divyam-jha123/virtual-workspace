# Asset Manager configuration. Copy to .env for local runs outside Docker.

# API port (the native /v1 contract + /api UI surface).
PORT=3300

# Single static key guarding /v1. The map MCP sends this as BOTH
# `Authorization: Bearer <key>` and `X-API-Key`.
ASSET_MANAGER_API_KEY=dev-key

# Postgres. In Docker this is set by the compose file; locally point at 5434.
#
# DATABASE_URL      what the app queries through (pooled, on hosted Postgres)
# DIRECT_DATABASE_URL  what `prisma migrate` uses (never the pooler)
#
# Against local Postgres there is no pooler, so both are the same string.
DATABASE_URL=postgresql://asset_manager:asset_manager@localhost:5434/asset_manager?schema=public
DIRECT_DATABASE_URL=postgresql://asset_manager:asset_manager@localhost:5434/asset_manager?schema=public

# --- Neon (hosted Postgres) -------------------------------------------------
# Copy BOTH strings from the Neon dashboard; they differ by host. The pooled one
# contains "-pooler". SSL is mandatory, so keep ?sslmode=require on both.
# Put the real values in .env (gitignored) — never in docker-compose, which is
# committed.
#
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/asset_manager?sslmode=require"
# DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/asset_manager?sslmode=require"
#
# Neon suspends an idle database, so the first query after a pause takes a
# second or two to wake it. That is expected, not a fault.

# Local object store root (behind the Storage interface).
ASSET_MANAGER_STORAGE_DIR=./storage

# The map-mcp workspace to vendor into. Defaults to <repo>/content.
MAP_MCP_CONTENT_DIR=../../content

# Browser origins allowed by CORS (localhost only).
ASSET_MANAGER_CORS_ORIGINS=http://localhost:3301,http://127.0.0.1:3301

# Upload / ZIP safety caps.
ASSET_MANAGER_MAX_UPLOAD_BYTES=67108864
ASSET_MANAGER_MAX_ZIP_ENTRIES=2000
ASSET_MANAGER_MAX_ZIP_TOTAL_BYTES=268435456

# UI -> API base (used by the Next app in the browser).
NEXT_PUBLIC_API_BASE=http://localhost:3300
