{
  "name": "asset-manager",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev:api": "tsx watch src/index.ts",
    "dev:web": "next dev -p 3301",
    "dev": "concurrently -n api,web -c blue,magenta \"pnpm dev:api\" \"pnpm dev:web\"",
    "build": "node scripts/prisma.mjs generate && tsc -p tsconfig.server.json && next build",
    "build:api": "node scripts/prisma.mjs generate && tsc -p tsconfig.server.json",
    "start:api": "node dist/index.js",
    "start:web": "next start -p 3301",
    "start": "concurrently -n api,web -c blue,magenta \"pnpm start:api\" \"pnpm start:web\"",
    "lint": "tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "node scripts/prisma.mjs generate",
    "migrate:dev": "node scripts/prisma.mjs migrate dev",
    "migrate:deploy": "node scripts/prisma.mjs migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "vendor": "tsx src/vendor/cli.ts",
    "migrate:status": "node scripts/prisma.mjs migrate status"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "express": "^4.21.2",
    "fast-xml-parser": "^4.5.1",
    "multer": "^1.4.5-lts.1",
    "next": "^14.2.21",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yauzl": "^3.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/supertest": "^6.0.2",
    "@types/yauzl": "^2.10.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.4.49",
    "prisma": "^6.1.0",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
